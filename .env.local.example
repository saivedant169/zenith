# Copy to .env.local (`npm run setup` does it for you). Every value here is
# optional: with the whole file blank, Zenith runs as a single local admin user.
# `npm run doctor` reports which of these are set and what each one turns on.
#
# Containers: `docker compose --profile app up` reads .env and then .env.local,
# so this file is picked up as-is. The one exception is the NEXT_PUBLIC_* values
# below — Next inlines those into the browser bundle at BUILD time, and Compose
# only interpolates build arguments from .env, never from .env.local. To build a
# container image with auth on, those four must be in .env. See docs/RUNNING.md.

# ---- Supabase auth (optional; without these Zenith runs in local demo mode) ----
# From `supabase start` (local) or Project Settings → API (cloud).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Current name is the publishable key; the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by `npm run seed:users` to create test accounts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Which "Continue with …" buttons /login and /signup show. Comma-separated; known
# names are `github` and `google`. List a provider only after enabling it in the
# Supabase dashboard (Authentication → Providers) and registering
# <site>/auth/callback as its redirect URL — a name here is a button, and a button
# for a provider the project has not enabled fails at the provider. Empty (the
# default) shows no buttons and no divider: email and password only.
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=
# To enable Google, set the provider list above to google (or github,google).
# Follow docs/google-auth.md for Google/Supabase redirect URLs and manual linking.
# Local Supabase only: enable [auth.external.google] in supabase/config.toml,
# then supply these server-side credentials. Hosted Supabase stores them in its dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---- Waitlist (optional; no landing-page form is installed) ----
# Public POST /api/waitlist intake and platform access gating are separate switches.
# Both remain off until the operator intentionally enables them. See docs/waitlist.md.
ZENITH_WAITLIST_ENABLED=0
ZENITH_WAITLIST_GATE_ENABLED=0
# Comma-separated immutable Supabase user UUIDs allowed to use /admin/waitlist.
# Workspace ownership/admin roles NEVER grant waitlist administration.
ZENITH_WAITLIST_ADMIN_IDS=
# Required before enabling the gate: canonical accounts created BEFORE this ISO
# timestamp retain access. New accounts need an admitted, verified email address.
ZENITH_WAITLIST_EXISTING_USERS_BEFORE=
# Required for public intake; a private random string of at least 32 characters.
ZENITH_WAITLIST_RATE_LIMIT_SECRET=
# Optional only when your reverse proxy overwrites this header reliably:
# x-forwarded-for | x-real-ip | x-vercel-forwarded-for. Blank uses a shared bucket.
ZENITH_WAITLIST_TRUSTED_IP_HEADER=

# ---- Secret store (optional; without it Zenith holds no secret values) ----
# Encrypts the per-workspace secret store at <ZENITH_DATA>/secrets.json (AES-256-GCM).
# 32 bytes, base64 or hex. Generate one with:
#   openssl rand -base64 32
# ...which prints something shaped like the line below. Do NOT use this example value.
#   ZENITH_SECRET_KEY=YmFzZTY0IGV4YW1wbGUgb25seSAtIGdlbmVyYXRlIHlvdXJz
# Keep the same key: values written under an old one cannot be read back, and
# there is no recovery — the store is the only copy Zenith has. Without this
# variable every secret write is refused (saying so), and Zenith can still
# record a reference to a value you keep in your own secret manager.
ZENITH_SECRET_KEY=

# ---- Email alert delivery (optional; webhook and Slack channels need neither) ----
# The SMTP server an email delivery channel sends through. The password is in
# this string, so it never reaches a response or a log line.
#   ZENITH_SMTP_URL=smtp://user:pass@smtp.example.com:587
# Use smtps:// for implicit TLS (usually port 465).
ZENITH_SMTP_URL=
# The From address on alert email. Required alongside ZENITH_SMTP_URL — without
# it every send is refused, saying so.
#   ZENITH_ALERT_FROM=Zenith <zenith@example.com>
ZENITH_ALERT_FROM=
# Email delivery also needs the nodemailer package: `npm install`. Until then an
# email channel reports the missing package as the delivery failure, and webhook
# and Slack channels are unaffected.

# ---- Optional ----
# Enables Claude language parsing in the Navigator (deterministic planner otherwise).
ANTHROPIC_API_KEY=
# LocalStack edge endpoint override (default http://localhost:4566).
ZENITH_LOCALSTACK_ENDPOINT=

# Absolute origin used for OpenGraph/share card URLs. Defaults to http://localhost:3400.
NEXT_PUBLIC_SITE_URL=

# ---- Runtime (optional; the defaults are what you want locally) ----
# Where the JSON snapshot, revisions, and the event and audit logs live.
# Defaults to ./.data. One process per directory — a second one is refused at
# boot, because the store rewrites the whole snapshot on save and the two would
# silently overwrite each other. The container sets this to /data.
ZENITH_DATA=
# Which implementation backs the store: `file` (default — the JSON snapshot and
# JSONL logs under ZENITH_DATA, and the default) or `postgres`, which puts the
# organisational slice — workspaces, members, invites, connections, projects,
# environments, settings — in Supabase Postgres and needs
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY below. It is a HYBRID
# today: revisions, deployments, events, the audit log, findings, navigator
# runs, alerts and secrets still live under ZENITH_DATA (Phase 3 debt, stated
# at the top of src/lib/db/postgres-store.ts), so a serverless deployment on
# `postgres` still keeps that half per-instance. Apply
# supabase/migrations/0001_system_of_record.sql first, then import an existing
# data directory with `npm run migrate:postgres`.
ZENITH_STORE=
# "1" collapses simulated step durations, so a deploy finishes in seconds.
# Used by the test suite and the smoke test. Default "0".
ZENITH_FAST=
# debug | info | warn | error. Default info.
ZENITH_LOG_LEVEL=
# Model id for the Navigator's optional language front-end, used only when
# ANTHROPIC_API_KEY is set. Default claude-opus-5.
ZENITH_LLM_MODEL=

# Per-step deadline for a deployment step, in milliseconds (default 300000). A hung provider fails the step with a fix instead of pinning the deployment.
ZENITH_STEP_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Hosted apps (Revision 3). Every variable is optional; the defaults are the
# local single-host profile. See docs/hosted/CONTRACTS-R3.md and PROVIDERS.md.
# ---------------------------------------------------------------------------
# "1" turns on hosted admission rules: no app_metadata.role re-grant, no
# empty-workspace takeover, fail-closed identity, app-host gateway.
ZENITH_HOSTED_MODE=
# Where browsers reach the control app (exchange redirects come back here).
ZENITH_CONTROL_ORIGIN=
# Apps are served at <slug>.<domain>. *.localhost needs no DNS; production
# needs a wildcard record and a wildcard certificate.
ZENITH_APP_DOMAIN=
ZENITH_APP_SCHEME=
# local (this process serves artifacts + broker) | cloudflare (Workers for
# Platforms; needs ZENITH_CF_ACCOUNT_ID, ZENITH_CF_NAMESPACE, ZENITH_CF_API_TOKEN).
ZENITH_RUNTIME=
# none | recipe-local (same host, separate process, no submitted code runs) |
# e2b (needs E2B_API_KEY) | docker (needs a daemon and the zenith-recipe image).
ZENITH_BUILD_RUNNER=
ZENITH_ARTIFACT_DIR=
# sqlite (embedded control.sqlite authority; the default and the only one this
# build ships) | postgres (parses, and is refused at boot until it exists).
ZENITH_HOSTED_STORE=
# Object-storage bucket published artifacts live in. Default zenith-artifacts.
ZENITH_ARTIFACT_BUCKET=
# Supabase Postgres connection string for ZENITH_HOSTED_STORE=postgres — it must be the Supavisor TRANSACTION-mode pooler string (port 6543), not the direct 5432 host. Contains the database password: treat it like SUPABASE_SERVICE_ROLE_KEY and never paste it into a log or an issue.
SUPABASE_DB_URL=
# none | filesystem (ZENITH_BACKUP_DIR) | s3 (ZENITH_BACKUP_S3_BUCKET, _REGION, _ENDPOINT).
# _REGION is the bucket's region (falls back to AWS_REGION, then AWS_DEFAULT_REGION); omit it only with a custom _ENDPOINT.
# Backups are AES-256-GCM under ZENITH_BACKUP_KEY (32 bytes; NOT the secret-store key).
ZENITH_BACKUP_TARGET=
ZENITH_BACKUP_DIR=
ZENITH_BACKUP_S3_BUCKET=
ZENITH_BACKUP_S3_REGION=
ZENITH_BACKUP_S3_ENDPOINT=
ZENITH_BACKUP_KEY=
ZENITH_CF_ACCOUNT_ID=
ZENITH_CF_NAMESPACE=
ZENITH_CF_API_TOKEN=
# Optional Cloudflare extras: a candidate probe URL template ({script}/{slug})
# and the path of the bundled broker worker module to upload.
ZENITH_CF_PROBE_URL=
ZENITH_CF_BROKER_MODULE=
E2B_API_KEY=
# Shared secret the Cloudflare gateway worker presents to the control policy API.
ZENITH_POLICY_SHARED_SECRET=
# Salt for pseudonymous subject hashes in activation events.
ZENITH_EVENTS_SALT=
# Monthly envelope for the 50/75/90 % spending alerts (0 disables).
ZENITH_SPEND_ENVELOPE_USD=
# Comma-separated Supabase user ids excluded from activation metrics.
ZENITH_FOUNDER_SUBJECTS=
# Comma-separated Supabase user ids classified as test actors (also: any
# example.test / zenith.test email).
ZENITH_TEST_SUBJECTS=
# From address for app invitations (falls back to ZENITH_ALERT_FROM).
ZENITH_INVITE_FROM=

# Set to 1 to include PostgresStore in the store contract suite
# (tests/db/contract). It runs against the REAL project named by
# NEXT_PUBLIC_SUPABASE_URL, so it is opt-in and never on by default: every row
# it writes is filed under a `contract-<random>` workspace id and deleted in
# afterAll. Requires SUPABASE_SERVICE_ROLE_KEY.
ZENITH_CONTRACT_POSTGRES=

# ---- Serverless background work (Vercel; required in production there) ----
# Zenith's background machinery — the engine's 250ms ticker, the alert
# evaluator, the alert outbox drainer, the hosted job runner — needs a
# long-lived process, and a serverless instance is not one. Instead, four
# internal routes each run ONE bounded pass when they are called:
#
#   POST /api/internal/tick/engine   advance in-flight deployments (~20s budget)
#   POST /api/internal/tick/alerts   one alert evaluation pass
#   POST /api/internal/tick/outbox   drain the alert delivery outbox
#   POST /api/internal/tick/jobs     one hosted publish-job runner pass
#   GET  /api/internal/keepalive     daily touch, so a free Supabase project
#                                    is never paused for inactivity
#
# They are authorised by the Vercel convention `Authorization: Bearer
# <CRON_SECRET>`, compared in constant time. Unset, every one of them answers
# 503 and runs nothing — an internal route must never become public because a
# variable was forgotten. The name is Vercel's, so Vercel Cron attaches the
# header itself once the variable is set on the project.
#
# Set the SAME value in three places: the Vercel project (production AND
# preview), and as a GitHub Actions repository secret named CRON_SECRET, which
# .github/workflows/tick.yml uses to curl the four tick routes every five
# minutes (Vercel Cron on the Hobby plan runs at most once per day, so it can
# only do the keepalive). Generate one with:
#   openssl rand -hex 32
# Locally you never need this: `next dev` runs the real timers.
CRON_SECRET=

# ------------------------------------------------------------------------------
# Platform control store (ADR-0002, docs/platform/ARCHITECTURE.md)
# ------------------------------------------------------------------------------
# Operations, leases/fence tokens, approvals, policy decisions, resources and
# observed state live in the `platform` schema. Locally this is PGlite (an
# in-process Postgres) under <ZENITH_DATA>/platform-pg — nothing to install.
# In production point it at Postgres and run `npm run migrate:platform` once
# per schema version; the app refuses to start the platform store when behind.
#   ZENITH_PLATFORM_DB       pglite | postgres (default: postgres when a URL is set)
#   ZENITH_PLATFORM_DB_URL   falls back to SUPABASE_DB_URL; carries a password
#   ZENITH_PLATFORM_DB_MAX   pool size (default 5)
ZENITH_PLATFORM_DB=
ZENITH_PLATFORM_DB_URL=
ZENITH_PLATFORM_DB_MAX=

# ------------------------------------------------------------------------------
# Workload identity and control-plane signing (ADR-0006, ADR-0007, ADR-0010)
# ------------------------------------------------------------------------------
# Zenith is an OIDC issuer so customer clouds can trust it without any stored
# keys. Generate keys with the one-liners in src/lib/credentials/OPERATIONS.md;
# in production prefer the KMS variants. Both private keys are secrets.
#   ZENITH_OIDC_ISSUER            e.g. https://tryzenith.cloud/api/oidc
#   ZENITH_OIDC_SIGNING_JWK       RS256 private JWK  (or ZENITH_OIDC_KMS_KEY_ID)
#   ZENITH_CONTROL_SIGNING_JWK    Ed25519 private JWK (or ZENITH_CONTROL_KMS_KEY_ID)
#   ZENITH_*_EXTRA_PUBLIC_JWKS    public keys to keep publishing during rotation
ZENITH_OIDC_ISSUER=
ZENITH_OIDC_SIGNING_JWK=
ZENITH_CONTROL_SIGNING_JWK=
